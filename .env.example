# Buttondown newsletter. PUBLIC_ keys are exposed to the browser; Buttondown
# subscriber-write tokens can only add subscribers, not read them or send emails.
PUBLIC_BUTTONDOWN_API_KEY=your_buttondown_api_key_here
BUTTONDOWN_CLIENT_KEY=

# Resend API key — server-only, used for auth and transactional emails.
RESEND_API_KEY=your_resend_api_key_here

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change_me
BETTER_AUTH_URL=http://localhost:4321

# Database — local SQLite file for dev (works offline), Turso URL + token in production
DATABASE_URL=file:./data/local.db
DATABASE_AUTH_TOKEN=
